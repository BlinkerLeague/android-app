<?xml version="1.0" encoding="utf-8"?>
<!--
  lint FullBackupContent 검사는 data-extraction-rules의 device_* 도메인을 몰라 "Unexpected domain"으로 잡음(오탐).
  프레임워크 FullBackup.java는 device_* 도메인을 해석하므로 그대로 둠.
-->
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="FullBackupContent">
    <!-- 토큰(Keystore 암호화) · 기준값 캐시 · 운행 DB는 클라우드에 백업하지 않음 (allowBackup=false와 같은 뜻) -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <!-- 토큰(Keystore 암호화) · 기준값 캐시 · 운행 DB는 다른 기기로 옮기지 않음 -->
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
