<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!--
      릴리스에 들어가는 권한은 실제 기능에 쓰는 것만 둠. Pleos 심사: Vehicle SDK 권한은 App Market 사전 승인이 필요하고,
      승인되지 않은 권한을 선언하면 심사를 통과할 수 없음. 조사용 권한은 src/debug/AndroidManifest.xml에 있음.
    -->

    <!-- 서버 API (운행 업로드·점수·미션·등록) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 음성 안내: Pleos TextToSpeech SDK가 요구하는 권한 (SDK의 TTS_PERMISSION 상수) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- 위치: Pleos FusedLocation SDK (@RequiresPermission). 기기 prot=dangerous → 런타임 허용 필요 -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />

    <!-- 차량 신호 (Pleos Vehicle SDK @RequiresPermission): TurnSignal=CAR_LIGHTS, SteeringWheel 각도·Gear=CAR_DRIVE -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />

    <!-- 차량 속도: CarProperty PERF_VEHICLE_SPEED. dangerous → 런타임 허용 필요 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />

    <!-- 운행 수집 포그라운드 서비스(specialUse)와 부팅·앱 업데이트 시 시작 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      백업·기기 간 전송: 토큰(Keystore 암호화) · 기준값 캐시 · 운행 DB를 옮기지 않음.
      API 28~30은 allowBackup=false로 백업·전송 모두 꺼짐. API 31+ 기기 간 전송은 allowBackup으로 막히지 않아
      dataExtractionRules에서 모든 도메인을 제외함.
    -->
    <application
        android:name=".BlinkerLeagueApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BlinkerLeague"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 운행 수집: 앱 화면이 보일 때(MainActivity)와 부팅·앱 업데이트 직후(BootReceiver)에 시작 -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.TripCollectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="운행 중 차량 신호(방향지시등·핸들 각도·기어·속도)를 받아 회전 시 깜빡이 사용을 판정함. 앱이 화면에 없어도 운행 전체를 기록해야 해서 포그라운드 서비스로 실행" />
        </service>

    </application>

</manifest>